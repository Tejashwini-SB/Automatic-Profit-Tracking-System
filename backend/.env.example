# Required environment variables for the backend
# Copy this to .env and fill in your values.

# PostgreSQL connection string (from Neon, Render Postgres, or local)
DATABASE_URL=postgresql://user:password@host/dbname

# Strong random secret for JWT signing — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-random-secret-here

# Comma-separated list of allowed frontend origins (e.g. your Vercel URL)
# Leave blank to allow all localhost origins in development
ALLOWED_ORIGINS=https://your-app.vercel.app
